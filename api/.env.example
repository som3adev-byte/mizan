# Port the API listens on. The web app runs on 3000.
PORT=3001
# The API runs as mizan_app (row-level security applies).
DATABASE_URL=postgresql://mizan_app:<app-password>@localhost:5433/mizan
# Migrations run as the table owner.
MIGRATE_DATABASE_URL=postgresql://mizan_owner:<owner-password>@localhost:5433/mizan
# Test database (same roles, separate data).
TEST_DATABASE_URL=postgresql://mizan_app:<app-password>@localhost:5433/mizan_test
TEST_MIGRATE_DATABASE_URL=postgresql://mizan_owner:<owner-password>@localhost:5433/mizan_test
# Encrypts MFA secrets at rest: 32 random bytes, base64 (openssl rand -base64 32).
MFA_ENCRYPTION_KEY=
# Allowed origin(s) for state-changing requests, comma-separated.
WEB_ORIGIN=http://localhost:3000

# Where uploaded evidence files are kept (local disk until hosting is decided).
EVIDENCE_DIR=storage/evidence
